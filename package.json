{
  "name": "vscode-markdown-reader",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.10",
  "publisher": "chengjian",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ytcheng/vscode-markdown-reader.git"
  },
  "bugs": {
    "url": "https://github.com/ytcheng/vscode-markdown-reader/issues"
  },
  "homepage": "https://github.com/ytcheng/vscode-markdown-reader#readme",
  "license": "MIT",
  "icon": "assets/markdown-reader-icon.png",
  "galleryBanner": {
    "color": "#24345F",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown reader",
    "markdown preview",
    "markdown viewer",
    "reading mode",
    "table of contents",
    "toc",
    "documentation",
    "notes"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=22.22.2"
  },
  "activationEvents": [
    "onCustomEditor:markdownReader.preview"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build:css": "lessc media/reader.less media/reader.css && lessc media/high-contrast.less media/high-contrast.css",
    "build": "npm run build:css && node esbuild.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "prepare:visual": "node dist/test/visual/generate.js",
    "test:visual": "npm run build && npm run prepare:visual && playwright test test/visual/visual.spec.ts",
    "build:test-extension": "tsc -p test/extension/tsconfig.json",
    "test:extension": "npm run build && npm run build:test-extension && node dist/test/runTest.js",
    "check": "npm run check:types && npm run test:unit && npm run build",
    "verify": "npm run check:types && npm run test:unit && npm run build && npm run test:extension && npm run test:visual"
  },
  "dependencies": {
    "@md-reader/theme": "2.0.5",
    "@mdit/plugin-tex": "1.1.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.17.2",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.2",
    "@types/pixelmatch": "7.1.0",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.0",
    "less": "4.9.1",
    "mocha": "12.0.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.diffEditorAssociations": {
        "*.md": "default"
      }
    },
    "customEditors": [
      {
        "viewType": "markdownReader.preview",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownReader.openPreview",
        "title": "%command.openPreview%",
        "category": "%extension.name%"
      },
      {
        "command": "markdownReader.openSource",
        "title": "%command.openSource%",
        "category": "%extension.name%",
        "icon": "$(edit)"
      },
      {
        "command": "markdownReader.togglePreview",
        "title": "%command.togglePreview%",
        "category": "%extension.name%"
      },
      {
        "command": "markdownReader.toggleToc",
        "title": "%command.toggleToc%",
        "category": "%extension.name%"
      },
      {
        "command": "markdownReader.readingSettings",
        "title": "%command.readingSettings%",
        "category": "%extension.name%"
      },
      {
        "command": "markdownReader.exportHtml",
        "title": "%command.exportHtml%",
        "category": "%extension.name%"
      },
      {
        "command": "markdownReader.print",
        "title": "%command.print%",
        "category": "%extension.name%"
      }
    ],
    "keybindings": [
      {
        "command": "markdownReader.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname == .md"
      },
      {
        "command": "markdownReader.openSource",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeCustomEditorId == markdownReader.preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownReader.openSource",
          "when": "activeCustomEditorId == markdownReader.preview",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownReader.readingSettings",
          "when": "activeCustomEditorId == markdownReader.preview"
        },
        {
          "command": "markdownReader.exportHtml",
          "when": "activeCustomEditorId == markdownReader.preview"
        },
        {
          "command": "markdownReader.print",
          "when": "activeCustomEditorId == markdownReader.preview"
        }
      ]
    },
    "configuration": {
      "title": "%extension.name%",
      "properties": {
        "markdownReader.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-CN"],
          "enumItemLabels": ["%setting.language.label.auto%", "%setting.language.label.en%", "%setting.language.label.zhCN%"],
          "enumDescriptions": ["%setting.language.auto%", "%setting.language.en%", "%setting.language.zhCN%"],
          "default": "auto",
          "description": "%setting.language.description%"
        },
        "markdownReader.toc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.toc.enabled%"
        },
        "markdownReader.toc.maxDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "%setting.toc.maxDepth%"
        },
        "markdownReader.toc.width": {
          "type": "integer",
          "default": 260,
          "minimum": 180,
          "maximum": 480,
          "description": "%setting.toc.width%"
        },
        "markdownReader.content.maxWidth": {
          "type": "integer",
          "default": 900,
          "minimum": 560,
          "maximum": 1600,
          "description": "%setting.content.maxWidth%",
          "scope": "resource"
        },
        "markdownReader.theme": {
          "type": "string",
          "enum": [
            "reader",
            "github"
          ],
          "default": "reader",
          "description": "%setting.theme.description%",
          "enumDescriptions": ["%setting.theme.reader%", "%setting.theme.github%"],
          "scope": "resource"
        },
        "markdownReader.colorMode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "light",
          "description": "%setting.colorMode.description%",
          "enumDescriptions": ["%setting.colorMode.auto%", "%setting.colorMode.light%", "%setting.colorMode.dark%"],
          "scope": "resource"
        },
        "markdownReader.fontFamily": {
          "type": "string",
          "default": "",
          "maxLength": 200,
          "description": "%setting.fontFamily.description%",
          "scope": "resource"
        },
        "markdownReader.fontSize": {
          "type": "integer",
          "default": 16,
          "minimum": 12,
          "maximum": 32,
          "description": "%setting.fontSize.description%",
          "scope": "resource"
        },
        "markdownReader.fontSizeMode": {
          "type": "string",
          "enum": ["editor", "custom"],
          "default": "editor",
          "description": "%setting.fontSizeMode.description%",
          "enumDescriptions": ["%setting.fontSizeMode.editor%", "%setting.fontSizeMode.custom%"],
          "scope": "resource"
        },
        "markdownReader.largeFile.mode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "%setting.largeFile.mode.description%",
          "enumDescriptions": ["%setting.largeFile.mode.auto%", "%setting.largeFile.mode.on%", "%setting.largeFile.mode.off%"],
          "scope": "resource"
        },
        "markdownReader.largeFile.thresholdKb": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 102400,
          "description": "%setting.largeFile.thresholdKb.description%",
          "scope": "resource"
        }
      }
    }
  }
}
